<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true"
    tools:context=".empresa.SetupEmpresa">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/toolbar_gradient"
        android:elevation="8dp"
        app:titleTextColor="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Verificação da Empresa"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"/>

    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Complete seu cadastro"
                        android:textSize="22sp"
                        android:textColor="#1A237E"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01"
                        android:lineHeight="28sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Preencha as informações para verificação da empresa"
                        android:textSize="14sp"
                        android:textColor="#5C6BC0"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nome da Empresa"
                        android:textSize="14sp"
                        android:textColor="#3949AB"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#F8FAFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#E8EAF6"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/inputNome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:textSize="16sp"
                            android:textColor="#1A237E"
                            android:fontFamily="sans-serif"
                            android:background="@android:color/transparent"
                            android:hint="Digite o nome completo da empresa"
                            android:textColorHint="#9FA8DA"
                            android:inputType="textCapWords"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email de Contato"
                        android:textSize="14sp"
                        android:textColor="#3949AB"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#F8FAFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#E8EAF6"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/inputContato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:textSize="16sp"
                            android:textColor="#1A237E"
                            android:fontFamily="sans-serif"
                            android:background="@android:color/transparent"
                            android:hint="exemplo@empresa.cv"
                            android:textColorHint="#9FA8DA"
                            android:inputType="textEmailAddress"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Localização"
                        android:textSize="14sp"
                        android:textColor="#3949AB"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#F8FAFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#E8EAF6"
                        app:strokeWidth="1dp">

                        <Spinner
                            android:id="@+id/spinnerLocal"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Área de Atividade"
                        android:textSize="14sp"
                        android:textColor="#3949AB"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#F8FAFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#E8EAF6"
                        app:strokeWidth="1dp">

                        <Spinner
                            android:id="@+id/spinnerArea"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@android:color/transparent"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descrição da Empresa"
                        android:textSize="14sp"
                        android:textColor="#3949AB"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#F8FAFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#E8EAF6"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/inputDescricao"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:textSize="16sp"
                            android:textColor="#1A237E"
                            android:fontFamily="sans-serif"
                            android:background="@android:color/transparent"
                            android:hint="Descreva a empresa, missão, valores..."
                            android:textColorHint="#9FA8DA"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:maxLines="5"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Máximo 500 caracteres"
                        android:textSize="12sp"
                        android:textColor="#9FA8DA"
                        android:textAlignment="viewEnd"
                        android:layout_marginBottom="4dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8EAF6"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info"
                        android:tint="#3949AB"
                        android:layout_marginRight="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="A verificação pode levar até 48 horas. Você será notificado por email."
                        android:textSize="12sp"
                        android:textColor="#5C6BC0"
                        android:lineHeight="16sp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Enviar para Verificação"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:backgroundTint="#3949AB"
                app:icon="@drawable/ic_send"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:elevation="4dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>