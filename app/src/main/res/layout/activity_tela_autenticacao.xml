<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/auth_background"
    android:fitsSystemWindows="true"
    tools:context=".autenticacao.TelaAutenticacao">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Área Superior: Logo e Título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="60dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="12dp"
                android:elevation="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/minhas_vagas"
                    app:tint="#1A237E"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="24dp"
                    android:contentDescription="Logo CV-Jobs"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CV-Jobs"
                android:textSize="42sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:shadowColor="#0D47A1"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conectando talentos a oportunidades"
                android:textSize="16sp"
                android:textColor="#E3F2FD"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.02"
                android:textAlignment="center"
                android:lineHeight="24sp"
                android:maxWidth="280dp"/>

        </LinearLayout>

        <!-- Card Inferior: Formulário / Botões -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#FFFFFF"
            android:elevation="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bem-vindo ao CV-Jobs"
                    android:textSize="24sp"
                    android:textColor="#1A237E"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:lineHeight="32sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Encontre vagas ou candidatos ideais"
                    android:textSize="14sp"
                    android:textColor="#5C6BC0"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:layout_marginBottom="32dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signbuttton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Criar Conta"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#3949AB"
                    app:icon="@drawable/ic_person_add"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:elevation="4dp"
                    android:layout_marginBottom="16dp"
                    android:stateListAnimator="@null"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginbutton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Entrar na Conta"
                    android:textSize="16sp"
                    android:textColor="#3949AB"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#E8EAF6"
                    app:strokeColor="#3949AB"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_login"
                    app:iconTint="#3949AB"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="24dp"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ao continuar, você concorda com nossos"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Termos de Uso"
                        android:textSize="12sp"
                        android:textColor="#3949AB"
                        android:fontFamily="sans-serif-medium"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Política de Privacidade"
                        android:textSize="12sp"
                        android:textColor="#3949AB"
                        android:fontFamily="sans-serif-medium"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>