<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/minhas_vagas"
            app:tint="#3949AB"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            app:strokeColor="#E8EAF6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AGUARDE PELA APROVAÇÃO"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textColor="#1A237E"
                    android:fontFamily="sans-serif-medium"
                    android:lineHeight="30sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DA EMPRESA"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textColor="#1A237E"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"
                    android:lineHeight="30sp"/>

                <View
                    android:layout_width="80dp"
                    android:layout_height="2dp"
                    android:background="#3949AB"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seu perfil está em análise. Você receberá uma notificação assim que for aprovado."
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#5C6BC0"
                    android:fontFamily="sans-serif"
                    android:lineHeight="20sp"
                    android:layout_marginTop="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E0"
                    android:layout_marginTop="24dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_info"
                            app:tint="#F57C00"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: Em análise"
                            android:textSize="12sp"
                            android:textColor="#F57C00"
                            android:fontFamily="sans-serif-medium"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bttnStatus"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Atualizar Status"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:backgroundTint="#3949AB"
                app:icon="@drawable/ic_filter"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp"
                android:stateListAnimator="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bttnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sair"
                android:textSize="16sp"
                android:textColor="#3949AB"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:backgroundTint="#F8FAFF"
                app:strokeColor="#3949AB"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_logout"
                app:iconTint="#3949AB"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#E8EAF6"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_time"
                    app:tint="#5C6BC0"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tempo médio de aprovação: 24-48h"
                    android:textSize="12sp"
                    android:textColor="#5C6BC0"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_email"
                    app:tint="#5C6BC0"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notificação por email quando aprovado"
                    android:textSize="12sp"
                    android:textColor="#5C6BC0"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>